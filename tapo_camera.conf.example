# Z-Mod Tapo Camera configuration
# After editing, run ENABLE_PLUGIN name=tapo_camera in the printer console.
ENABLED=0
HOST=192.168.0.50
PORT=554
USERNAME=
PASSWORD=
# stream2 = 640x360 (light on Wi-Fi), stream1 = full resolution.
# Video is relayed as-is (no transcoding), so the printer CPU cost is the same for both.
STREAM=stream2
ASPECT_RATIO=16:9
FPS=15
# go2rtc HTTP API port (stream signalling + snapshots) and WebRTC media port (TCP+UDP).
API_PORT=1984
WEBRTC_PORT=8555
# Address the browser uses to reach the printer; "auto" detects the default-route IPv4.
HTTP_PUBLIC_HOST=auto
